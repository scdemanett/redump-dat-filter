{
  "name": "redump-dat-filter",
  "version": "0.3.0",
  "description": "Electron desktop app for filtering Redump DAT files by region.",
  "main": "dist-electron/main.js",
  "author": "Steven Demanett",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:watch:main\" \"npm:dev:electron\"",
    "dev:renderer": "node scripts/vite-dev.mjs",
    "watch:main": "tsup --config tsup.config.ts --watch",
    "dev:electron": "wait-on dist-electron/main.js dist-electron/preload.js http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon .",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsup --config tsup.config.ts",
    "build:renderer": "node scripts/vite-build.mjs",
    "clean": "rimraf dist dist-electron",
    "package": "npm run build && electron-builder && node scripts/rename-release-artifacts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "electron",
    "react",
    "redump",
    "dat"
  ],
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.redump.filter",
    "productName": "Redump DAT Filter",
    "artifactName": "redump-dat-filter-setup-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "scdemanett",
      "repo": "redump-dat-filter"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "zip"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
